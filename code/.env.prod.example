# ==========================================================================
# 生产环境配置模板（M5 部署包）
# 用法：cp .env.prod.example .env，逐项修改后执行 scripts/init-prod.sh
# 标 ★ 的项 MUST 修改；其余无特殊需求保持默认即可。
# ==========================================================================

# ── 基础 ────────────────────────────────────────────────
APP_ENV=prod
# ★ 应用密钥与 JWT 签名密钥：生成命令 openssl rand -hex 32（两个分别生成）
SECRET_KEY=please-change-me-to-64-hex-chars
JWT_SECRET=please-change-me-to-64-hex-chars-too
# 私有化部署固定为 default，不要改
TENANT_CODE=default

# ── 首次初始化 ──────────────────────────────────────────
# ★ 管理员 admin 的初始密码（至少 10 位，含大小写与数字）；首次登录后请在界面修改
ADMIN_PASSWORD=ChangeMe123!

# ── 对外端口 ────────────────────────────────────────────
# web 管理台/问答界面的宿主机端口，默认 80；如被占用可改 8080
WEB_PORT=80

# ── PostgreSQL ──────────────────────────────────────────
# ★ 三项都改成强密码/自定义值；该服务不暴露宿主机端口，仅容器内网访问
POSTGRES_DB=kagent
POSTGRES_USER=kagent
POSTGRES_PASSWORD=please-change-this-db-password

# ── Redis ───────────────────────────────────────────────
# ★ Redis 密码（生产启用 requirepass）
REDIS_PASSWORD=please-change-this-redis-password

# ── MinIO 对象存储 ──────────────────────────────────────
# ★ 两项访问密钥改成强密码（长度至少 8 位）；该服务不暴露宿主机端口
MINIO_ROOT_USER=kagent-minio
MINIO_ROOT_PASSWORD=please-change-this-minio-password
S3_BUCKET=kagent-docs

# ── LLM（OpenAI 兼容协议）──────────────────────────────
# ★ 必填：问答生成依赖外部大模型 API
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=请填入你的-API-KEY
LLM_MODEL=deepseek-chat

# ── 本地嵌入 / 重排模型 ─────────────────────────────────
# 默认使用编排内置的 bge-m3 / bge-reranker-v2-m3 本地服务，无需修改
# 首次启动会从 HF_ENDPOINT 下载模型权重（约 5GB），下载后缓存在 hf_cache 卷
EMBEDDING_BASE_URL=http://embedding:8000/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_MODEL_ID=BAAI/bge-m3
EMBEDDING_DIM=1024
RERANK_BASE_URL=http://reranker:8000/v1
RERANKER_MODEL=bge-reranker-v2-m3
RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3
# 国内环境模型权重下载镜像站
HF_ENDPOINT=https://hf-mirror.com

# ── 上传与合规 ─────────────────────────────────────────
MAX_UPLOAD_MB=100
ALLOWED_EXT=pdf,md,txt,xls,xlsx,docx
AUDIT_RETENTION_DAYS=365
# 私有化交付 = 单租户，保持 false
MULTI_TENANT=false
