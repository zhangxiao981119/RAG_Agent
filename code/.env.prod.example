# ==========================================================================
# 生产环境配置模板（M5 部署包）
# 用法：cp .env.prod.example .env，逐项修改后执行 scripts/init-prod.sh
# 标 ★ 的项 MUST 修改；其余无特殊需求保持默认即可。
# ==========================================================================

# ── 基础 ────────────────────────────────────────────────
APP_ENV=prod
# ★ JWT 签名密钥：生成命令 openssl rand -hex 32
# 应用层加密（RSA-OAEP）密钥对由后端在 Redis 内部自动生成，无需配置
JWT_SECRET=please-change-me-to-64-hex-chars
# 私有化部署固定为 default，不要改
TENANT_CODE=default

# ── 日志 ────────────────────────────────────────────────
# 结构化 JSON 日志级别：INFO / WARNING / ERROR / DEBUG；排障时临时调 DEBUG
LOG_LEVEL=INFO

# ── 首次初始化 ──────────────────────────────────────────
# ★ 管理员 admin 的初始密码（至少 10 位，含大小写与数字）；首次登录后请在界面修改
ADMIN_PASSWORD=ChangeMe123!

# ── 对外访问地址（TLS 入口）──────────────────────────────
# ★ gateway（Caddy）监听的站点地址：内网 IP 或内部主机名，例如 192.168.1.100 / rag.corp.local
#   入口固定监听宿主机 80/443；证书由 Caddy 内置 CA 自签，客户端需导入根证书（见 docs/DEPLOY.md §7）
SITE_ADDRESS=192.168.1.100

# ── PostgreSQL ──────────────────────────────────────────
# ★ 三项都改成强密码/自定义值；该服务不暴露宿主机端口，仅容器内网访问
POSTGRES_DB=kagent
POSTGRES_USER=kagent
POSTGRES_PASSWORD=please-change-this-db-password

# ── Redis ───────────────────────────────────────────────
# ★ Redis 密码（生产启用 requirepass）
REDIS_PASSWORD=please-change-this-redis-password

# ── MinIO 对象存储 ──────────────────────────────────────
# ★ 两项访问密钥改成强密码（长度至少 8 位）；该服务不暴露宿主机端口
MINIO_ROOT_USER=kagent-minio
MINIO_ROOT_PASSWORD=please-change-this-minio-password
S3_BUCKET=kagent-docs

# ── LLM（OpenAI 兼容协议）──────────────────────────────
# ★ 必填：问答生成依赖外部大模型 API
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=请填入你的-API-KEY
LLM_MODEL=deepseek-v4-flash

# ── 本地嵌入 / 重排模型 ─────────────────────────────────
# 默认使用编排内置的 bge-m3 / bge-reranker-v2-m3 本地服务，无需修改
# 首次启动会从 HF_ENDPOINT 下载模型权重（约 5GB），下载后缓存在 hf_cache 卷
EMBEDDING_BASE_URL=http://embedding:8000/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_MODEL_ID=BAAI/bge-m3
EMBEDDING_DIM=1024
RERANK_BASE_URL=http://reranker:8000/v1
RERANKER_MODEL=bge-reranker-v2-m3
RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3
# 国内环境模型权重下载镜像站
HF_ENDPOINT=https://hf-mirror.com

# ── 上传与合规 ─────────────────────────────────────────
MAX_UPLOAD_MB=100
ALLOWED_EXT=pdf,md,txt,xls,xlsx,docx
# 扫描件 OCR / 多模态视觉抽取（M7 D6）：默认 false = 仅支持文本层 PDF；
# 置 true 后扫描件 PDF 与图片改由多模态视觉链路抽取文本入库（需 LLM 具备视觉能力）。
OCR_ENABLED=false
AUDIT_RETENTION_DAYS=365
# 私有化交付 = 单租户，保持 false
MULTI_TENANT=false

# ── 可观测性（Grafana 看板与告警）──────────────────────
# 监控栈（prometheus + grafana）随 prod 编排内置，均不发布宿主端口；
# 看板入口：https://<SITE_ADDRESS>/grafana/ （与 SITE_ADDRESS 同一 TLS 入口）
GRAFANA_ADMIN_USER=admin
# ★ Grafana 管理员密码（首次登录用，登录后可在界面修改）
GRAFANA_ADMIN_PASSWORD=please-change-this-grafana-password
