# ==========================================================================
# 生产环境配置模板（M5 部署包）
# 用法：cp .env.prod.example .env，逐项修改后执行 scripts/init-prod.sh
# 标 ★ 的项 MUST 修改；其余无特殊需求保持默认即可。
# ==========================================================================

# ── 基础 ────────────────────────────────────────────────
APP_ENV=prod
# ★ JWT 签名密钥：生成命令 openssl rand -hex 32
# 应用层加密（RSA-OAEP）密钥对由后端在 Redis 内部自动生成，无需配置
JWT_SECRET=please-change-me-to-64-hex-chars
# ★ 同步源凭据存储态加密密钥（M7 WU-M-11 / INV-M-07）：MUST 生成独立密钥，禁止使用开发默认值
# 生成命令：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=please-generate-a-fernet-key
# 私有化部署固定为 default，不要改
TENANT_CODE=default

# ── 日志 ────────────────────────────────────────────────
# 结构化 JSON 日志级别：INFO / WARNING / ERROR / DEBUG；排障时临时调 DEBUG
LOG_LEVEL=INFO

# ── 首次初始化 ──────────────────────────────────────────
# ★ 管理员 admin 的初始密码（至少 10 位，含大小写与数字）；首次登录后请在界面修改
ADMIN_PASSWORD=ChangeMe123!

# ── 对外访问地址（TLS 入口）──────────────────────────────
# ★ gateway（Caddy）监听的站点地址：内网 IP 或内部主机名，例如 192.168.1.100 / rag.corp.local
#   入口固定监听宿主机 80/443；证书由 Caddy 内置 CA 自签，客户端需导入根证书（见 docs/DEPLOY.md §7）
SITE_ADDRESS=192.168.1.100

# ── PostgreSQL ──────────────────────────────────────────
# ★ 三项都改成强密码/自定义值；该服务不暴露宿主机端口，仅容器内网访问
POSTGRES_DB=kagent
POSTGRES_USER=kagent
POSTGRES_PASSWORD=please-change-this-db-password

# ── Redis ───────────────────────────────────────────────
# ★ Redis 密码（生产启用 requirepass）
REDIS_PASSWORD=please-change-this-redis-password

# ── MinIO 对象存储 ──────────────────────────────────────
# ★ 两项访问密钥改成强密码（长度至少 8 位）；该服务不暴露宿主机端口
MINIO_ROOT_USER=kagent-minio
MINIO_ROOT_PASSWORD=please-change-this-minio-password
S3_BUCKET=kagent-docs

# ── LLM（OpenAI 兼容协议）──────────────────────────────
# ★ 必填：问答生成依赖外部大模型 API
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=请填入你的-API-KEY
LLM_MODEL=deepseek-v4-flash

# ── 本地嵌入 / 重排模型 ─────────────────────────────────
# 默认使用编排内置的 bge-m3 / bge-reranker-v2-m3 本地服务，无需修改
# 首次启动会从 HF_ENDPOINT 下载模型权重（约 5GB），下载后缓存在 hf_cache 卷
EMBEDDING_BASE_URL=http://embedding:8000/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_MODEL_ID=BAAI/bge-m3
EMBEDDING_DIM=1024
RERANK_BASE_URL=http://reranker:8000/v1
RERANKER_MODEL=bge-reranker-v2-m3
RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3
# 重排开关：默认 false。本机 CPU 下重排远超 3s 超时，开启也必降级且白等；
# false 时检索层不发起调用、健康检查与启动均不探活，直接走 vector 口径。
# 换到 GPU / 更强算力后置 true 启用（启用前 MUST 重标 RELEVANCE_THRESHOLD_RERANK）。
RERANK_ENABLED=false
# 国内环境模型权重下载镜像站
HF_ENDPOINT=https://hf-mirror.com

# ── 上传与合规 ─────────────────────────────────────────
MAX_UPLOAD_MB=100
# 图片扩展名已进默认白名单；但图片能否入库还取决于 OCR_ENABLED：
#   OCR_ENABLED=false 时上传图片会被 415 拒绝并提示 IMAGE_REQUIRES_OCR（不会静默失败）。
ALLOWED_EXT=pdf,md,txt,xls,xlsx,docx,png,jpg,jpeg,gif,webp,bmp
# 扫描件 OCR / 多模态视觉抽取（M7 D6）：默认 false = 仅支持文本层 PDF；
# 置 true 后扫描件 PDF 与图片改由多模态视觉链路抽取文本入库（需 LLM 具备视觉能力）。
OCR_ENABLED=false
# ── 文档图像质量门禁（去噪 / 去污 + 质量识别）──────────
# 门禁只做检测与分流（pass / enhance / reject_to_manual），水印只标记不擦像素。
# 关闭 gate 会失去「转人工」这道兜底；关闭 enhance 只保留检测、不动像素。
# ★ 两个开关都会改变入库文本，切换后 MUST 重跑全量评估再回填指标。
IMAGE_QUALITY_GATE_ENABLED=true
IMAGE_ENHANCE_ENABLED=true
AUDIT_RETENTION_DAYS=365
# ── DB 连接池（P1-5 压测标定，口径见 settings.db_pool_size 的注释）──
# 每个在途问答请求长期占 1 条连接（get_db 的 yield 覆盖整条 SSE 流），流式中瞬时 2 条。
# 实测：合计 20 条时 20 并发 47% 失败；合计 40 条时 20 并发 0 失败、30 并发仍稳。
# ★ 扩副本 MUST 重算：(DB_POOL_SIZE+DB_MAX_OVERFLOW) × 副本数 + worker 池 ≤ PG max_connections(100) 预留后
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
# worker 解析任务已被 OCR_MAX_CONCURRENCY=1 串行化，池不需要大
WORKER_DB_POOL_SIZE=5
WORKER_DB_MAX_OVERFLOW=5
# 私有化交付 = 单租户，保持 false
MULTI_TENANT=false

# ── 可观测性（Grafana 看板与告警）──────────────────────
# 监控栈（prometheus + grafana）随 prod 编排内置，均不发布宿主端口；
# 看板入口：https://<SITE_ADDRESS>/grafana/ （与 SITE_ADDRESS 同一 TLS 入口）
GRAFANA_ADMIN_USER=admin
# ★ Grafana 管理员密码（首次登录用，登录后可在界面修改）
GRAFANA_ADMIN_PASSWORD=please-change-this-grafana-password
