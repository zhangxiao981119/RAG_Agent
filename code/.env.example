APP_ENV=dev
# 结构化 JSON 日志级别：INFO / WARNING / ERROR / DEBUG
LOG_LEVEL=INFO
# JWT 签名密钥：dev 可留空（运行时随机生成，重启即失效）；多副本/需要 token 跨重启存活时必须显式设置
JWT_SECRET=
# 同步源凭据存储态加密密钥（Fernet，INV-M-07）：dev 可留空（内置开发密钥）；
# 生产 MUST 生成独立密钥注入：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
TENANT_CODE=default
DATABASE_URL=postgresql+asyncpg://user:pass@postgres:5432/kagent
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=kagent-docs
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
EMBEDDING_BASE_URL=http://embedding:8000
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
RERANK_BASE_URL=http://reranker:8000
RERANK_MODEL=bge-reranker-v2-m3
# 重排开关：默认 false。本机 CPU 下重排远超 3s 超时，开启也必降级且白等；
# false 时检索层不发起调用、健康检查与启动均不探活，直接走 vector 口径。
# 换到 GPU / 更强算力后置 true 启用（启用前 MUST 重标 RELEVANCE_THRESHOLD_RERANK）。
RERANK_ENABLED=false
# 本地嵌入/重排服务镜像（可用其他 OpenAI 兼容服务替换）
# digest 与 registry 绑定；换镜像站/私有仓库时重新解析后替换：docker image inspect --format '{{.RepoDigests}}' <ref>
EMBEDDING_IMAGE=docker.m.daocloud.io/michaelf34/infinity:latest-cpu@sha256:161ef2dd48ba050ad29a413d671270502acb4ad67759d695eb0d325c033a935d
RERANKER_IMAGE=docker.m.daocloud.io/michaelf34/infinity:latest-cpu@sha256:161ef2dd48ba050ad29a413d671270502acb4ad67759d695eb0d325c033a935d
MAX_UPLOAD_MB=100
ALLOWED_EXT=pdf,md,txt,xls,xlsx,docx,pptx
# 启用图片入库时（需同时 OCR_ENABLED=true）改为：
# ALLOWED_EXT=pdf,md,txt,xls,xlsx,docx,pptx,png,jpg,jpeg,gif,webp,bmp
# 扫描件 OCR / 多模态视觉抽取（M7 D6）：默认 false = 仅支持文本层 PDF；
# 置 true 后扫描件 PDF 与图片改由多模态视觉链路抽取文本入库。
# ★ 同时是 docx/PDF 文档内嵌图抽取的总开关：置 true 后内嵌图经视觉 LLM
#   转录为「[图片转录]」块入库 —— LLM MUST 具备视觉能力。
#   开发期可接多模态 API 代理；生产 MUST 将 LLM_BASE_URL/LLM_MODEL 切换为
#   本地部署的视觉模型（数据不出域），详见 docs/DEPLOY.md。
OCR_ENABLED=false
AUDIT_RETENTION_DAYS=365
MULTI_TENANT=false
POSTGRES_DB=kagent
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
