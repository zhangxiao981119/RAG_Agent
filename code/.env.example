APP_ENV=dev
SECRET_KEY=change-me
TENANT_CODE=default
DATABASE_URL=postgresql+asyncpg://user:pass@postgres:5432/kagent
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=kagent-docs
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
EMBEDDING_BASE_URL=http://embedding:8000
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
RERANK_BASE_URL=http://reranker:8000
RERANK_MODEL=bge-reranker-v2-m3
# 本地嵌入/重排服务镜像（可用其他 OpenAI 兼容服务替换）
EMBEDDING_IMAGE=michaelf34/infinity:latest
RERANKER_IMAGE=michaelf34/infinity:latest
MAX_UPLOAD_MB=100
ALLOWED_EXT=pdf,md,txt,xls,xlsx
AUDIT_RETENTION_DAYS=365
MULTI_TENANT=false
POSTGRES_DB=kagent
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
